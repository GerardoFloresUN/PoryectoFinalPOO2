@{
    ViewData["Title"] = "Inicio Biomagnetismo";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/aos/2.3.1/aos.css" />
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/slick-carousel/1.8.1/slick.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/slick-carousel/1.8.1/slick-theme.min.css">
    <title>@ViewData["Title"]</title>
    <style>
        body {
            font-family: 'Arial', sans-serif;
            background-color: #f4f4f9;
            color: #333;
            margin: 0;
            padding: 0;
        }

        .hero-section {
            background-color: #0056b3; /* Azul Vivo */
            color: #fff;
            text-align: center;
            padding: 100px 20px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
        }

        .hero-section h1 {
            font-size: 3rem;
            font-weight: bold;
            margin-bottom: 20px;
        }

        .hero-section p {
            font-size: 1.2rem;
            max-width: 600px;
            margin: 0 auto 40px;
        }

        .hero-section .btn {
            margin: 10px;
            padding: 10px 20px;
            font-size: 1rem;
        }

        .hero-section .btn-primary {
            background-color: #004080; /* Azul Vivo más oscuro */
            border-color: #004080;
        }

        .hero-section .btn-outline-light {
            border-color: #ffffff;
            color: #ffffff;
        }

        .features {
            padding: 60px 20px;
            background-color: #fff;
            text-align: center;
        }

        .features h2 {
            margin-bottom: 40px;
            color: #0056b3; /* Azul Vivo */
        }

        .features .feature {
            display: flex;
            justify-content: center;
            flex-wrap: wrap;
            margin-bottom: 30px;
        }

        .features .feature div {
            flex: 1;
            max-width: 300px;
            padding: 20px;
            margin: 10px;
            box-shadow: 0 0 10px rgba(0,0,0,0.1);
            border-radius: 10px;
            background-color: #f9f9f9;
        }

        .features .feature i {
            color: #0056b3; /* Azul Vivo */
        }

        .testimonials {
            background-color: #f8f9fa;
            padding: 60px 20px;
            text-align: center;
        }

        .testimonials h2 {
            margin-bottom: 40px;
            color: #0056b3; /* Azul Vivo */
        }

        .testimonials blockquote {
            margin: 20px auto;
            padding: 20px;
            border-left: 5px solid #0056b3; /* Azul Vivo */
            max-width: 600px;
            background-color: #fff;
            border-radius: 10px;
            box-shadow: 0 0 10px rgba(0,0,0,0.1);
        }

        .carousel .carousel-item img {
            max-height: 500px;
            object-fit: cover;
            width: 100%;
        }

        .more-info {
            background-color: #f4f4f4;
            padding: 60px 20px;
            text-align: center;
        }

        .more-info h2 {
            margin-bottom: 40px;
            color: #0056b3; /* Azul Vivo */
        }

        .more-info .info-item {
            margin-bottom: 30px;
            background-color: #fff;
            padding: 20px;
            border-radius: 10px;
            box-shadow: 0 0 10px rgba(0,0,0,0.1);
            position: relative;
        }

        .more-info .info-item .more-text {
            display: none;
            margin-top: 10px;
            text-align: left;
        }

        .more-info .info-item.active .more-text {
            display: block;
        }

        .footer {
            background-color: #0056b3; /* Azul Vivo */
            color: #fff;
            text-align: center;
            padding: 20px;
            position: relative;
            bottom: 0;
            width: 100%;
        }
    </style>
</head>
<body>
    <section class="hero-section" data-aos="fade-in" data-aos-duration="1000">
        <h1 data-aos="fade-up" data-aos-delay="200">Terapias de Biomagnetismo</h1>
        <p data-aos="fade-up" data-aos-delay="400">Descubre el poder del biomagnetismo para mejorar tu bienestar físico y emocional. Ofrecemos terapias innovadoras con imanes, zapper y mucho más.</p>
        <img src="~/img/perfil.jpg" width="400" height="350">
    </section>

    <section class="features">
        <div class="container">
            <h2>Servicios Principales</h2>
            <div class="feature">
                <div data-aos="fade-up" data-aos-delay="200">
                    <i class="fas fa-magnet fa-3x"></i>
                    <h3>Terapia con Imanes</h3>
                    <p>Utilizamos imanes de alta calidad para equilibrar la energía del cuerpo y promover la salud.</p>
                </div>
                <div data-aos="fade-up" data-aos-delay="400">
                    <i class="fas fa-bolt fa-3x"></i>
                    <h3>Aplicación de Zapper</h3>
                    <p>Tratamientos con zapper para eliminar patógenos y mejorar la vitalidad del organismo.</p>
                </div>
                <div data-aos="fade-up" data-aos-delay="600">
                    <i class="fas fa-heartbeat fa-3x"></i>
                    <h3>Liberación de Emociones</h3>
                    <p>Técnicas de biomagnetismo para liberar bloqueos emocionales y restaurar el equilibrio mental.</p>
                </div>
                <div data-aos="fade-up" data-aos-delay="800">
                    <i class="fas fa-spa fa-3x"></i>
                    <h3>Masaje de Columna</h3>
                    <p>Masajes terapéuticos específicos para aliviar dolores y mejorar la postura.</p>
                </div>
                <div data-aos="fade-up" data-aos-delay="1000">
                    <i class="fas fa-vials fa-3x"></i>
                    <h3>Nivelación de Energía</h3>
                    <p>Tratamientos para equilibrar la energía de los chakras y fomentar la armonía corporal.</p>
                </div>
            </div>
        </div>
    </section>

    <section class="testimonials">
        <div class="container">
            <h2>Reseñas</h2>
            <div class="testimonial-carousel">
                <blockquote data-aos="fade-up" data-aos-delay="200">
                    <p>"La terapia con imanes ha cambiado mi vida. Siento una paz y bienestar que nunca había experimentado."</p>
                    <footer>Laura Gómez, <cite title="Source Title">Paciente</cite></footer>
                </blockquote>
                <blockquote data-aos="fade-up" data-aos-delay="400">
                    <p>"El zapper es increíble, me siento más vital y con más energía que nunca."</p>
                    <footer>Juan Rodríguez, <cite title="Source Title">Cliente</cite></footer>
                </blockquote>
                <blockquote data-aos="fade-up" data-aos-delay="600">
                    <p>"La liberación de emociones me ha ayudado a superar bloqueos emocionales. ¡Muy recomendable!"</p>
                    <footer>María Sánchez, <cite title="Source Title">Paciente</cite></footer>
                </blockquote>
            </div>
        </div>
    </section>

    <section class="more-info">
        <div class="container">
            <h2>Más Información</h2>
            <div class="info-item" data-aos="fade-up" data-aos-delay="200">
                <h3>¿Qué es el Biomagnetismo?</h3>
                <p>El biomagnetismo es una terapia alternativa que utiliza imanes para restaurar el equilibrio del cuerpo y mejorar la salud.</p>
                <button class="btn btn-primary btn-read-more">Leer Más</button>
                <div class="more-text">
                    <p>Esta terapia fue desarrollada por el Dr. Isaac Goiz Durán en 1988 y ha demostrado ser eficaz en el tratamiento de diversas afecciones de salud, incluyendo dolores crónicos, infecciones, y desequilibrios energéticos. El biomagnetismo se basa en el principio de que muchas enfermedades son causadas por desequilibrios en el pH del cuerpo, los cuales pueden ser corregidos mediante la aplicación de imanes en puntos específicos del cuerpo.</p>
                </div>
            </div>
            <div class="info-item" data-aos="fade-up" data-aos-delay="400">
                <h3>Beneficios del Zapper</h3>
                <p>El zapper es un dispositivo que utiliza frecuencias eléctricas para eliminar patógenos y mejorar la vitalidad del cuerpo.</p>
                <button class="btn btn-primary btn-read-more">Leer Más</button>
                <div class="more-text">
                    <p>El zapper fue popularizado por la Dra. Hulda Clark y se ha utilizado para tratar una variedad de condiciones, desde infecciones parasitarias hasta problemas de energía y fatiga crónica. Funciona enviando corrientes eléctricas de baja frecuencia a través del cuerpo, lo que se cree que desactiva y elimina patógenos como virus, bacterias y parásitos.</p>
                </div>
            </div>
            <div class="info-item" data-aos="fade-up" data-aos-delay="600">
                <h3>Testimonios de Pacientes</h3>
                <p>Lee más testimonios de nuestros pacientes que han experimentado mejoras significativas en su salud y bienestar.</p>
                <button class="btn btn-primary btn-read-more">Leer Más</button>
                <div class="more-text">
                    <p>Nuestros pacientes han reportado una amplia gama de beneficios tras recibir tratamientos de biomagnetismo y zapper, incluyendo la reducción del dolor, la mejora del estado de ánimo, y una mayor energía y vitalidad. Muchos han encontrado alivio de condiciones que no respondían a otros tipos de tratamientos, lo que ha transformado sus vidas y les ha dado una nueva esperanza para el futuro.</p>
                </div>
            </div>
        </div>
    </section>

    <footer class="footer">
        <div class="container">
            <p>&copy; 2024 Biomagnetismo Terapias. Todos los derechos reservados.</p>
        </div>
    </footer>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.5.1/jquery.slim.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/popperjs/core@2.5.3/dist/umd/popper.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/aos/2.3.1/aos.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/slick-carousel/1.8.1/slick.min.js"></script>
    <script>
        AOS.init();

        $(document).ready(function(){
            $('.testimonial-carousel').slick({
                infinite: true,
                slidesToShow: 1,
                slidesToScroll: 1,
                autoplay: true,
                autoplaySpeed: 2000,
                arrows: false,
                dots: true
            });

            $('.btn-read-more').click(function() {
                $(this).siblings('.more-text').toggle();
            });
        });
    </script>
</body>
</html>
